# Local setup: copy this file to .env and replace every example value.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional: instead of ADMIN_PASSWORD, you may set ADMIN_PASSWORD_HASH.
# COOKIE_SECURE=0 for local HTTP; set COOKIE_SECURE=1 on HTTPS hosting.
COOKIE_SECURE=0
DATA_DIR=data
DATABASE_PATH=data/collection.db
